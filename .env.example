# Copy to local .env; never commit secrets.
APP_ENV=development
APP_NAME=ProfitAI
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://profitai:change_me@localhost:5432/profitai
SECRET_KEY=replace_with_local_random_secret
CORS_ORIGINS=http://localhost:3000
# Optional LLM provider settings; keep keys server-side and out of Git.
LLM_PROVIDER=
LLM_API_KEY=
